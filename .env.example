# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mlm_platform?schema=public"

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================================================
# BLOCKCHAIN CONFIGURATION
# ============================================================================
BLOCKCHAIN_NETWORK=bsc-testnet
BLOCKCHAIN_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BLOCKCHAIN_WS_URL=wss://data-seed-prebsc-1-s1.binance.org:8545
USDT_CONTRACT_ADDRESS=0x1F71139BACbf9Ab15d239342f7783C69951736f7
DEPOSIT_WALLET_ADDRESS=your-deposit-wallet-address-here
PRIVATE_KEY=your-private-key-here-never-commit-this
REQUIRED_CONFIRMATIONS=12

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@mlmplatform.com
EMAIL_NAME=MLM Platform
EMAIL_ENABLED=false
FRONTEND_URL=http://localhost:5173

# ============================================================================
# TRADING CONFIGURATION
# ============================================================================
MORNING_TRADE_TIME=09:00
EVENING_TRADE_TIME=18:00
TRADE_DURATION_MINUTES=2
TRADE_PERCENTAGE=1
PROFIT_DISTRIBUTION_USER=60
PROFIT_DISTRIBUTION_ADMIN=40

# ============================================================================
# DEPOSIT CONFIGURATION
# ============================================================================
MINIMUM_DEPOSIT=50
DEPOSIT_BONUS_PERCENTAGE=5
DEPOSIT_BONUS_THRESHOLD=50

# ============================================================================
# REFERRAL CONFIGURATION
# ============================================================================
REFERRAL_BONUS_TIER1_MIN=50
REFERRAL_BONUS_TIER1_MAX=999
REFERRAL_BONUS_TIER1_PERCENTAGE=5
REFERRAL_BONUS_TIER2_MIN=1000
REFERRAL_BONUS_TIER2_MAX=9999
REFERRAL_BONUS_TIER2_PERCENTAGE=10

# ============================================================================
# WITHDRAWAL CONFIGURATION
# ============================================================================
WITHDRAWAL_FEE_PERCENTAGE=2
WITHDRAWAL_PENALTY_PERCENTAGE=30
WITHDRAWAL_PENALTY_DAYS=90
MINIMUM_WITHDRAWAL=10

# ============================================================================
# CYCLE BONUS CONFIGURATION
# ============================================================================
CYCLE_DURATION_DAYS=10
CYCLE_BONUS_LV1_RANK=100
CYCLE_BONUS_LV1_CYCLE=30
CYCLE_BONUS_LV2_RANK=300
CYCLE_BONUS_LV2_CYCLE=150
CYCLE_BONUS_LV3_RANK=800
CYCLE_BONUS_LV3_CYCLE=500
CYCLE_BONUS_LV4_RANK=2000
CYCLE_BONUS_LV4_CYCLE=1200
CYCLE_BONUS_LV5_RANK=5000
CYCLE_BONUS_LV5_CYCLE=2400
CYCLE_BONUS_LV6_RANK=12000
CYCLE_BONUS_LV6_CYCLE=5000
CYCLE_BONUS_LV7_RANK=25000
CYCLE_BONUS_LV7_CYCLE=10000

# ============================================================================
# RANK CONFIGURATION
# ============================================================================
RANK_LV1_DIRECT_REFERRALS=5
RANK_LV1_DIRECT_DEPOSIT=300
RANK_LV1_TEAM_SIZE=5
RANK_LV2_DIRECT_LV1=2
RANK_LV2_TEAM_SIZE=25
RANK_LV3_DIRECT_LV1=3
RANK_LV3_TEAM_SIZE=125
RANK_LV4_DIRECT_LV1=4
RANK_LV4_TEAM_SIZE=500
RANK_LV5_DIRECT_LV1=5
RANK_LV5_TEAM_SIZE=1000
RANK_LV6_DIRECT_LV1=6
RANK_LV6_TEAM_SIZE=2000
RANK_LV7_DIRECT_LV1=7
RANK_LV7_TEAM_SIZE=5000

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Auth endpoints (login, refresh, forgot/reset password) — only failed attempts count
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
CORS_ORIGIN=http://localhost:3000

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=info
LOG_DIR=logs
LOG_FILE_API=api.log
LOG_FILE_ERROR=error.log
LOG_FILE_TRADE=trade.log
LOG_FILE_BLOCKCHAIN=blockchain.log
LOG_FILE_CRON=cron.log
LOG_FILE_SECURITY=security.log

# ============================================================================
# SWAGGER CONFIGURATION
# ============================================================================
SWAGGER_TITLE=MLM Platform API
SWAGGER_DESCRIPTION=USDT Investment, Referral, Auto Trading, Rank & Reward Platform
SWAGGER_VERSION=1.0.0
SWAGGER_CONTACT_EMAIL=support@mlmplatform.com

# ============================================================================
# CRON CONFIGURATION
# ============================================================================
CRON_MORNING_TRADE=0 9 * * *
CRON_EVENING_TRADE=0 18 * * *
CRON_TRADE_SETTLEMENT=*/2 * * * *
CRON_DEPOSIT_VERIFICATION=*/5 * * * *
CRON_RANK_EVALUATION=0 0 * * *
CRON_POOL_BONUS=0 0 */10 * *
CRON_NOTIFICATION_SENDER=*/10 * * * *
CRON_DAILY_REPORT=0 23 * * *
CRON_FAILED_RETRY=0 */30 * * *

# ============================================================================
# CLOUDINARY CONFIGURATION (image uploads)
# ============================================================================
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ============================================================================
# ADMIN CONFIGURATION
# ============================================================================
ADMIN_EMAIL=admin@mlmplatform.com
ADMIN_PASSWORD=Admin@123456
